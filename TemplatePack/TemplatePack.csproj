<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>ExtrabbitCode.Inventor.Core.Template</PackageId>
		<TargetFramework>net8.0</TargetFramework>
		<Version>1.5.0</Version>
		<Authors>ExtrabbitCode</Authors>
		<Company>ExtrabbitCode</Company>
		<PackageType>Template</PackageType>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<Description>Autodesk Inventor Add‑in Template</Description>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\.nupkgs</PackageOutputPath>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<RepositoryUrl>https://github.com/TWiesendanger/ExtrabbitCode.Inventor.Core.Template</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Inventor.Core.Template\README.md" Pack="true" PackagePath="README.md" />
		<None Include="..\images\inventor.png" Pack="true" PackagePath="icon.png" />
		<Content Include="..\Inventor.Core.Template\**\*" PackagePath="..\Inventor.Core.Template\" Exclude="..\Inventor.Core.Template\bin\**;&#xD;&#xA;                      ..\Inventor.Core.Template\obj\**;&#xD;&#xA;                      *.user;*.suo;*.nupkg" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="..\Inventor.Core.Template\ExtrabbitCode.InstallFolder\ExtrabbitCode.Inventor.Core.Template\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="..\Inventor.Core.Template\ExtrabbitCode.Inventor.Core.Template.csproj.user" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="..\.gitignore" PackagePath="..\Inventor.Core.Template\" />
	  <Content Include="..\.editorconfig" PackagePath="..\Inventor.Core.Template\" />
	</ItemGroup>
</Project>